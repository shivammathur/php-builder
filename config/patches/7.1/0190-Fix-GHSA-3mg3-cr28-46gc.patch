@@ -45,13 +45,65 @@ int fpm_status_init_child(struct fpm_worker_pool_s *wp) /* {{{ */
 }
 /* }}} */
 
+static char *fpm_status_escape(const char *str, zend_bool encode_html, zend_bool encode_json, zend_string **tmp)
+{
+	*tmp = NULL;
+	if (str[0] == '\0') {
+		return NULL;
+	}
+	if (encode_html) {
+		*tmp = php_escape_html_entities_ex((unsigned char *) str, strlen(str), 1,
+				ENT_DISALLOWED | ENT_HTML_DOC_XML1 | ENT_COMPAT, NULL, 1);
+		return ZSTR_VAL(*tmp);
+	}
+	if (encode_json) {
+		const unsigned char *p = (const unsigned char *) str;
+		const unsigned char *end = p + strlen(str);
+		char *out;
+		static const char hex[] = "0123456789abcdef";
+
+		*tmp = zend_string_alloc(6 * strlen(str), 0);
+		out = ZSTR_VAL(*tmp);
+		while (*p) {
+			if (*p >= 0x80) {
+				size_t len = 0;
+				int status;
+
+				php_next_utf8_char(p, end - p, &len, &status);
+				if (status == SUCCESS) {
+					memcpy(out, p, len);
+					out += len;
+				}
+				p += len;
+				continue;
+			}
+			if (*p == '"' || *p == '\\') {
+				*out++ = '\\';
+				*out++ = *p;
+			} else if (*p < 0x20) {
+				memcpy(out, "\\u00", 4);
+				out += 4;
+				*out++ = hex[*p >> 4];
+				*out++ = hex[*p & 15];
+			} else {
+				*out++ = *p;
+			}
+			++p;
+		}
+		*out = '\0';
+		ZSTR_LEN(*tmp) = out - ZSTR_VAL(*tmp);
+		return ZSTR_VAL(*tmp);
+	}
+	return (char *) str;
+}
