From a3bbda82bde90d2a5410df2e1cc4b496b701c844 Mon Sep 17 00:00:00 2001
From: Ilija Tovilo <ilija.tovilo@me.com>
Date: Sun, 15 Nov 2026 15:25:20 +0100
Subject: [PATCH] Fix GHSA-gr4f-wgx5-jpfv: DATEG(tzcache) use-after-free

(cherry picked from commit bec24bd8d748fac37c99d5b1ce4107570cd265d9)

diff --git a/main/main.c b/main/main.c
index 1c2f3937db0529b08fc9c2d80b3d8bcb9a78df58..37afdbc2d7cced9b3c4a701b89694bf0e170f7e4 100644
--- a/main/main.c
+++ b/main/main.c
@@ -702,15 +702,7 @@ PHPAPI ZEND_COLD void php_log_err_with_severity(char *log_message, int syslog_ty
 			zend_string *error_time_str;
 
 			time(&error_time);
-#ifdef ZTS
-			if (!php_during_module_startup()) {
-				error_time_str = php_format_date("d-M-Y H:i:s e", 13, error_time, 1);
-			} else {
-				error_time_str = php_format_date("d-M-Y H:i:s e", 13, error_time, 0);
-			}
-#else
-			error_time_str = php_format_date("d-M-Y H:i:s e", 13, error_time, 1);
-#endif
+			error_time_str = php_format_date("d-M-Y H:i:s e", 13, error_time, PG(modules_activated) && EG(active));
 			len = spprintf(&tmp, 0, "[%s] %s%s", ZSTR_VAL(error_time_str), log_message, PHP_EOL);
 #ifdef PHP_WIN32
 			php_flock(fd, 2);
