From: =?utf-8?b?T25kxZllaiBTdXLDvQ==?= <ondrej@sury.org>
Date: Mon, 9 Nov 2026 16:29:04 +0100
Subject: Load the shared phar extension by path in opcache CLI server tests

---
 ext/opcache/tests/issue0115.phpt | 2 +-
 ext/opcache/tests/issue0149.phpt | 2 +-
 2 files changed, 2 insertions(+), 2 deletions(-)

diff --git a/ext/opcache/tests/issue0115.phpt b/ext/opcache/tests/issue0115.phpt
index c31f72e..b63cdcf 100644
--- a/ext/opcache/tests/issue0115.phpt
+++ b/ext/opcache/tests/issue0115.phpt
@@ -36,7 +36,7 @@
 
 $ini = '-d opcache.enable=1 -d opcache.enable_cli=1';
 if (file_exists(ini_get('extension_dir').'/phar.'.PHP_SHLIB_SUFFIX)) {
-    $ini .= ' -d extension=phar.'.PHP_SHLIB_SUFFIX;
+    $ini .= ' -d extension='.ini_get('extension_dir').'/phar.'.PHP_SHLIB_SUFFIX;
 }
 php_cli_server_start($ini);
 
diff --git a/ext/opcache/tests/issue0149.phpt b/ext/opcache/tests/issue0149.phpt
index 20fe763..6b83d62 100644
--- a/ext/opcache/tests/issue0149.phpt
+++ b/ext/opcache/tests/issue0149.phpt
@@ -24,7 +24,7 @@
 
 $ini = '-d opcache.enable=1 -d opcache.enable_cli=1 -d opcache.file_update_protection=0';
 if (file_exists(ini_get('extension_dir').'/phar.'.PHP_SHLIB_SUFFIX)) {
-    $ini .= ' -d extension=phar.'.PHP_SHLIB_SUFFIX;
+    $ini .= ' -d extension='.ini_get('extension_dir').'/phar.'.PHP_SHLIB_SUFFIX;
 }
 php_cli_server_start($ini);
 
