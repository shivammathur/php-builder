From 6a96ae06dbcaa6d4a958436bf390939fb8ec53d8 Mon Sep 17 00:00:00 2001
From: "Ian P. Christian" <ian.christian@zoopla.co.uk>
Date: Tue, 27 Oct 2026 17:59:48 +0100
Subject: [PATCH] Fix GHSA-jm4m-qfqx-967m: FPM worker stdio pipe fd closed
 twice

Backport of the GH-24046 fix (cd161267c0d2ca293b6959114d7c68867273bbda).

Co-authored-by: ndossche <7771979+ndossche@users.noreply.github.com>

(cherry picked from commit 8c38b791449708540fd356ddc6927f463faeca91)

diff --git a/sapi/fpm/fpm/fpm_children.c b/sapi/fpm/fpm/fpm_children.c
index 68c493d7645b9016766eef406fa71243c70e6e51..a229780c76113de7933a69511da13ec78c8e9b0c 100644
--- a/sapi/fpm/fpm/fpm_children.c
+++ b/sapi/fpm/fpm/fpm_children.c
@@ -71,7 +71,11 @@ static void fpm_child_close(struct fpm_child_s *child, int in_event_loop) /* {{{
 			fpm_event_fire(&child->ev_stdout);
 		}
 		if (child->fd_stdout != -1) {
+			if (in_event_loop) {
+				fpm_event_del(&child->ev_stdout);
+			}
 			close(child->fd_stdout);
+			child->fd_stdout = -1;
 		}
 	}
 
@@ -80,7 +84,11 @@ static void fpm_child_close(struct fpm_child_s *child, int in_event_loop) /* {{{
 			fpm_event_fire(&child->ev_stderr);
 		}
 		if (child->fd_stderr != -1) {
+			if (in_event_loop) {
+				fpm_event_del(&child->ev_stderr);
+			}
 			close(child->fd_stderr);
+			child->fd_stderr = -1;
 		}
 	}
 
