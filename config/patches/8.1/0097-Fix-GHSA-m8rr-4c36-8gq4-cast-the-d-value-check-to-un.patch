From: Jamal Tantaoui <jamal@tantaoui.com>
Date: Sun, 25 Oct 2026 16:00:15 +0100
Subject: Fix GHSA-m8rr-4c36-8gq4: cast the -d value check to unsigned char

From PHP 8.2, the value of -d options is checked in main/php_ini_builder.c,
where the official fix a38418777f65780d9d622197677e90567690fc07 casts it:
isalnum((unsigned char)*val). Before 8.2 the same check is duplicated in the
CLI, CGI, FPM and phpdbg SAPIs, which the backport left uncast.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 sapi/cgi/cgi_main.c     | 2 +-
 sapi/cli/php_cli.c      | 2 +-
 sapi/fpm/fpm/fpm_main.c | 2 +-
 sapi/phpdbg/phpdbg.c    | 2 +-
 4 files changed, 4 insertions(+), 4 deletions(-)

diff --git a/sapi/cgi/cgi_main.c b/sapi/cgi/cgi_main.c
index c7bb7cc..fecb15e 100644
--- a/sapi/cgi/cgi_main.c
+++ b/sapi/cgi/cgi_main.c
@@ -1841,7 +1841,7 @@ int main(int argc, char *argv[])
 
 				if ((val = strchr(php_optarg, '='))) {
 					val++;
-					if (!isalnum(*val) && *val != '"' && *val != '\'' && *val != '\0') {
+					if (!isalnum((unsigned char)*val) && *val != '"' && *val != '\'' && *val != '\0') {
 						cgi_sapi_module.ini_entries = realloc(cgi_sapi_module.ini_entries, ini_entries_len + len + sizeof("\"\"\n\0"));
 						memcpy(cgi_sapi_module.ini_entries + ini_entries_len, php_optarg, (val - php_optarg));
 						ini_entries_len += (val - php_optarg);
diff --git a/sapi/cli/php_cli.c b/sapi/cli/php_cli.c
index 92e990f..72280f9 100644
--- a/sapi/cli/php_cli.c
+++ b/sapi/cli/php_cli.c
@@ -1257,7 +1257,7 @@ int main(int argc, char *argv[])
 
 				if ((val = strchr(php_optarg, '='))) {
 					val++;
-					if (!isalnum(*val) && *val != '"' && *val != '\'' && *val != '\0') {
+					if (!isalnum((unsigned char)*val) && *val != '"' && *val != '\'' && *val != '\0') {
 						ini_entries = realloc(ini_entries, ini_entries_len + len + sizeof("\"\"\n\0"));
 						memcpy(ini_entries + ini_entries_len, php_optarg, (val - php_optarg));
 						ini_entries_len += (val - php_optarg);
diff --git a/sapi/fpm/fpm/fpm_main.c b/sapi/fpm/fpm/fpm_main.c
index 12d2a1e..0fcdbce 100644
--- a/sapi/fpm/fpm/fpm_main.c
+++ b/sapi/fpm/fpm/fpm_main.c
@@ -1616,7 +1616,7 @@ int main(int argc, char *argv[])
 
 				if ((val = strchr(php_optarg, '='))) {
 					val++;
-					if (!isalnum(*val) && *val != '"' && *val != '\'' && *val != '\0') {
+					if (!isalnum((unsigned char)*val) && *val != '"' && *val != '\'' && *val != '\0') {
 						cgi_sapi_module.ini_entries = realloc(cgi_sapi_module.ini_entries, ini_entries_len + len + sizeof("\"\"\n\0"));
 						memcpy(cgi_sapi_module.ini_entries + ini_entries_len, php_optarg, (val - php_optarg));
 						ini_entries_len += (val - php_optarg);
diff --git a/sapi/phpdbg/phpdbg.c b/sapi/phpdbg/phpdbg.c
index e1824ec..a646f8c 100644
--- a/sapi/phpdbg/phpdbg.c
+++ b/sapi/phpdbg/phpdbg.c
@@ -1211,7 +1211,7 @@ phpdbg_main:
 
 				if ((val = strchr(php_optarg, '='))) {
 				  val++;
-				  if (!isalnum(*val) && *val != '"' && *val != '\'' && *val != '\0') {
+				  if (!isalnum((unsigned char)*val) && *val != '"' && *val != '\'' && *val != '\0') {
 					  ini_entries = realloc(ini_entries, ini_entries_len + len + sizeof("\"\"\n\0"));
 					  memcpy(ini_entries + ini_entries_len, php_optarg, (val - php_optarg));
 					  ini_entries_len += (val - php_optarg);
