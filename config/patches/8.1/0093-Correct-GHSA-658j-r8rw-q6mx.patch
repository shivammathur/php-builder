 	STD_PHP_INI_ENTRY("session.use_cookies",        "1",         PHP_INI_ALL, OnUpdateSessionBool,   use_cookies,        php_ps_globals,    ps_globals)
 	STD_PHP_INI_ENTRY("session.use_only_cookies",   "1",         PHP_INI_ALL, OnUpdateSessionBool,   use_only_cookies,   php_ps_globals,    ps_globals)
 	STD_PHP_INI_ENTRY("session.use_strict_mode",    "0",         PHP_INI_ALL, OnUpdateSessionBool,   use_strict_mode,    php_ps_globals,    ps_globals)
diff --git a/ext/session/tests/session_cookie_samesite_active.phpt b/ext/session/tests/session_cookie_samesite_active.phpt
new file mode 100644
index 0000000000000000000000000000000000000000..881d8376edb1c180b580682c259931e53f91ce7b
--- /dev/null
+++ b/ext/session/tests/session_cookie_samesite_active.phpt
@@ -0,0 +1,15 @@
+--TEST--
+session.cookie_samesite can be changed during an active session when upload progress is disabled
+--INI--
+session.upload_progress.enabled=0
+session.use_cookies=0
+--FILE--
+<?php
+session_start();
+var_dump(ini_set('session.cookie_samesite', 'Lax'));
+var_dump(ini_get('session.cookie_samesite'));
+session_write_close();
+?>
+--EXPECT--
+string(0) ""
+string(3) "Lax"
diff --git a/ext/session/tests/session_cookie_samesite_upload_progress.phpt b/ext/session/tests/session_cookie_samesite_upload_progress.phpt
new file mode 100644
index 0000000000000000000000000000000000000000..795b1dd1e56aaaf339dd97a62ffd31b043d4e2c3
--- /dev/null
+++ b/ext/session/tests/session_cookie_samesite_upload_progress.phpt
@@ -0,0 +1,17 @@
+--TEST--
+session.cookie_samesite remains protected while upload progress is enabled
+--INI--
+session.upload_progress.enabled=1
+--FILE--
+<?php
+try {
+    ini_set('session.cookie_samesite', 'Lax');
+    echo "unexpected success\n";
+} catch (Error $e) {
+    echo "rejected\n";
+}
+var_dump(ini_get('session.cookie_samesite'));
+?>
+--EXPECT--
+rejected
+string(0) ""
