index b29fad233435782ae9bee5b1de0ef1fda190b91b..29d49bb483cf40423296d7e49d3598740cd356cd 100644
--- a/ext/session/session.c
+++ b/ext/session/session.c
@@ -723,6 +723,14 @@ static PHP_INI_MH(OnUpdateSessionString) /* {{{ */
 /* }}} */
 
 
+static PHP_INI_MH(OnUpdateSessionCookieSameSite) /* {{{ */
