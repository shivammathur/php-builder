-				return NULL;
+				return 0;
 			}
 			++last_header_name;
 		}
@@ -283,7 +278,7 @@ static zend_string *php_stream_http_response_headers_parse(php_stream_wrapper *w
 		php_stream_wrapper_log_error(wrapper, options,
 				"HTTP invalid response format (no colon in header line)!");
 		zend_string_efree(last_header_line_str);
-		return NULL;
+		return 0;
 	}
 
 	zend_bool store_header = 1;
@@ -308,7 +303,7 @@ static zend_string *php_stream_http_response_headers_parse(php_stream_wrapper *w
 					"HTTP Location header size is over the limit of %d bytes",
 					HTTP_HEADER_MAX_LOCATION_SIZE);
 			zend_string_efree(last_header_line_str);
-			return NULL;
+			return 0;
 		}
 		if (header_info->location_len == 0) {
 			header_info->location = emalloc(last_header_value_len + 1);
@@ -356,7 +351,7 @@ static zend_string *php_stream_http_response_headers_parse(php_stream_wrapper *w
 		zend_string_efree(last_header_line_str);
 	}
 
-	return NULL;
+	return 0;
 }
 
