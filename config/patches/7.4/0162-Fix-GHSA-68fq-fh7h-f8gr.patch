From 4d35248833da94be9524ba5aec694b8d2bf99426 Mon Sep 17 00:00:00 2001
From: Alexandre Daubois <alex.daubois@gmail.com>
Date: Fri, 13 Nov 2026 08:33:23 +0100
Subject: [PATCH] Fix GHSA-68fq-fh7h-f8gr: refuse keyless phar signature when
 .pubkey exists

The signature type is not covered by the signature, so an OpenSSL signed
phar could be downgraded to a keyless hash algorithm.

(cherry picked from commit 7050cf338092a93e7d4caa4b7dc0bb8771f52a01)

diff --git a/ext/phar/util.c b/ext/phar/util.c
index 639f091f8397a986c7258c0274eab1ade98f3bd5..745938f8069c2d42c7296930d1ada218d19ef53c 100644
--- a/ext/phar/util.c
+++ b/ext/phar/util.c
@@ -1506,6 +1506,23 @@ int phar_verify_signature(php_stream *fp, size_t end_of_phar, uint32_t sig_type,
 
 	php_stream_rewind(fp);
 
+	if (sig_type != PHAR_SIG_OPENSSL) {
+		php_stream_statbuf ssb;
+		char *pfile;
+		zend_bool has_pubkey;
+
+		spprintf(&pfile, 0, "%s.pubkey", fname);
+		has_pubkey = php_stream_stat_path_ex(pfile, PHP_STREAM_URL_STAT_QUIET, &ssb, NULL) == 0;
+		efree(pfile);
+
+		if (has_pubkey) {
+			if (error) {
+				spprintf(error, 0, "openssl public key found, but the signature does not use openssl");
+			}
+			return FAILURE;
+		}
+	}
+
 	switch (sig_type) {
 		case PHAR_SIG_OPENSSL: {
 #ifdef PHAR_HAVE_OPENSSL
