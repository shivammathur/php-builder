+			char *request_method_string, *request_uri_string, *query_string;
+			char *auth_user_string, *script_filename_string;
 			struct timeval duration, now;
 #ifdef HAVE_FPM_LQ
 			float cpu;
@@ -412,24 +469,11 @@ int fpm_status_handle_request(TSRMLS_D) /* {{{ */
 					}
 				}
 
-				request_uri_string = NULL;
-				len_uri = 0;
-				if (proc.request_uri[0] != '\0') {
-					if (!encode) {
-						request_uri_string = proc.request_uri;
-					} else {
-						request_uri_string = php_escape_html_entities_ex((unsigned char *)proc.request_uri, strlen(proc.request_uri), &len_uri, 1, ENT_DISALLOWED | ENT_HTML_DOC_XML1 | ENT_COMPAT, NULL, 1 TSRMLS_CC);
-					}
-				}
-				query_string = NULL;
-				len = 0;
-				if (proc.query_string[0] != '\0') {
-					if (!encode) {
-						query_string = proc.query_string;
-					} else {
-						query_string = php_escape_html_entities_ex((unsigned char *)proc.query_string, strlen(proc.query_string), &len, 1, ENT_DISALLOWED | ENT_HTML_DOC_XML1 | ENT_COMPAT, NULL, 1 TSRMLS_CC);
-					}
-				}
+				request_method_string = fpm_status_escape(proc.request_method, encode_html, encode_json, &tmp_request_method_string TSRMLS_CC);
+				request_uri_string = fpm_status_escape(proc.request_uri, encode_html, encode_json, &tmp_request_uri_string TSRMLS_CC);
+				query_string = fpm_status_escape(proc.query_string, encode_html, encode_json, &tmp_query_string TSRMLS_CC);
+				auth_user_string = fpm_status_escape(proc.auth_user, encode_html, encode_json, &tmp_auth_user_string TSRMLS_CC);
+				script_filename_string = fpm_status_escape(proc.script_filename, encode_html, encode_json, &tmp_script_filename_string TSRMLS_CC);
 
 #ifdef HAVE_FPM_LQ
 				/* prevent NaN */
@@ -453,13 +497,13 @@ int fpm_status_handle_request(TSRMLS_D) /* {{{ */
 					now_epoch - proc.start_epoch,
 					proc.requests,
 					duration.tv_sec * 1000000UL + duration.tv_usec,
-					proc.request_method[0] != '\0' ? proc.request_method : "-",
