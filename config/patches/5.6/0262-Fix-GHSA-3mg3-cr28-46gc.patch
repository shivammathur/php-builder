From 9cf0de6c024bf45c51fc86206773e795b288f3be Mon Sep 17 00:00:00 2001
From: Jakub Zelenka <bukka@php.net>
Date: Mon, 26 Oct 2026 20:10:08 +0100
Subject: [PATCH] Fix GHSA-3mg3-cr28-46gc: FPM XSS within status endpoint via
 user and script

The fix for GHSA-7qg2-v9fj-4mwv escaped only the request URI and query
string. The request method, auth user and script filename were still
printed raw in the full status output. Escape all of them using a common
helper.

(cherry picked from commit 1ecb92f2cdeb235bb10d6c220c9be4a13f527243)
(cherry picked from commit 6c7fb8fcb2bbbebfa6bd12fe9e015eb19319b3ea)

diff --git a/sapi/fpm/fpm/fpm_status.c b/sapi/fpm/fpm/fpm_status.c
index d9a82630892f7455d907a42507cc9140fe9bda47..d2ba77fd7567ca53511ac0dbae18243b244a2d74 100644
--- a/sapi/fpm/fpm/fpm_status.c
+++ b/sapi/fpm/fpm/fpm_status.c
@@ -46,13 +46,65 @@ int fpm_status_init_child(struct fpm_worker_pool_s *wp) /* {{{ */
 }
 /* }}} */
 
+static char *fpm_status_escape(const char *str, zend_bool encode_html, zend_bool encode_json, char **tmp TSRMLS_DC)
+{
+	*tmp = NULL;
+	if (str[0] == '\0') {
+		return NULL;
+	}
+	if (encode_html) {
+		size_t len;
+		*tmp = php_escape_html_entities_ex((unsigned char *) str, strlen(str), &len, 1,
+				ENT_DISALLOWED | ENT_HTML_DOC_XML1 | ENT_COMPAT, NULL, 1 TSRMLS_CC);
+		return *tmp;
+	}
+	if (encode_json) {
+		const unsigned char *p = (const unsigned char *) str;
+		const unsigned char *end = p + strlen(str);
+		char *out;
+		static const char hex[] = "0123456789abcdef";
+
+		*tmp = safe_emalloc(6, strlen(str), 1);
+		out = *tmp;
+		while (*p) {
+			if (*p >= 0x80) {
+				size_t len = 0;
+				int status;
+
+				php_next_utf8_char(p, end - p, &len, &status);
+				if (status == SUCCESS) {
+					memcpy(out, p, len);
+					out += len;
+				}
+				p += len;
+				continue;
+			}
+			if (*p == '"' || *p == '\\') {
+				*out++ = '\\';
+				*out++ = *p;
+			} else if (*p < 0x20) {
+				memcpy(out, "\\u00", 4);
+				out += 4;
+				*out++ = hex[*p >> 4];
+				*out++ = hex[*p & 15];
+			} else {
+				*out++ = *p;
+			}
+			++p;
+		}
+		*out = '\0';
+		return *tmp;
+	}
+	return (char *) str;
+}
