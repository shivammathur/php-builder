diff --git a/ext/mysqli/tests/fake_server.inc b/ext/mysqli/tests/fake_server.inc
index 1be0ddc..3f5ee34 100644
--- a/ext/mysqli/tests/fake_server.inc
+++ b/ext/mysqli/tests/fake_server.inc
@@ -711,6 +711,39 @@ function my_mysqli_test_stmt_response_row_over_read_string(my_mysqli_fake_server
     $conn->read(65536);
 }
 
+function my_mysqli_test_stmt_response_row_short_length(my_mysqli_fake_server_conn $conn, $field_name)
+{
+    $rh = $conn->packet_generator->server_stmt_execute_data_response($field_name);
+    /* The declared length cannot cover the fixed offsets of this field type. */
+    $rh[4]->packet_length = '090000';
+    $rh[4]->row_field2 = '01de';
+
+    $conn->send_server_greetings();
+    $conn->read();
+    $conn->send_server_ok();
+    $conn->read();
+    $conn->send_server_stmt_prepare_data_response($field_name);
+    $conn->read();
+    $conn->send($conn->packets_to_bytes($rh),
+        "Malicious Stmt Response for data $field_name [length too short]");
+    $conn->read(65536);
+}
+
+function my_mysqli_test_stmt_response_row_short_length_date(my_mysqli_fake_server_conn $conn)
+{
+    my_mysqli_test_stmt_response_row_short_length($conn, 'datval');
+}
+
+function my_mysqli_test_stmt_response_row_short_length_time(my_mysqli_fake_server_conn $conn)
+{
+    my_mysqli_test_stmt_response_row_short_length($conn, 'timval');
+}
+
+function my_mysqli_test_stmt_response_row_short_length_datetime(my_mysqli_fake_server_conn $conn)
+{
+    my_mysqli_test_stmt_response_row_short_length($conn, 'dtival');
+}
+
 function my_mysqli_test_stmt_response_row_over_read_two_fields(
     my_mysqli_fake_server_conn $conn,
     $field_name,
diff --git a/ext/mysqli/tests/mysqlnd-short-date-length.phpt b/ext/mysqli/tests/mysqlnd-short-date-length.phpt
new file mode 100644
index 0000000..94b48a8
--- /dev/null
+++ b/ext/mysqli/tests/mysqlnd-short-date-length.phpt
@@ -0,0 +1,22 @@
+--TEST--
+mysqlnd rejects a binary DATE field whose declared length is too short
+--EXTENSIONS--
+mysqli
+--FILE--
+<?php
+require_once 'fake_server.inc';
+$port = 33305;
+$process = run_fake_server_in_background('stmt_response_row_short_length_date', $port);
+$process->wait();
+$conn = new mysqli('127.0.0.1', 'root', '', '', $port);
+$stmt = $conn->prepare('SELECT strval, datval FROM data');
+$stmt->execute();
+$stmt->bind_result($str, $value);
+var_dump($stmt->fetch());
+$stmt->close();
+$conn->close();
+$process->terminate(true);
+echo "done\n";
+?>
+--EXPECTREGEX--
+(?s).*Malformed server packet\. Field length is too short for the field type.*bool\(false\).*done
