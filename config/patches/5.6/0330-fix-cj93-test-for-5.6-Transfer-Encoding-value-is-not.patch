Subject: fix cj93 test for 5.6 (Transfer-Encoding value is not trimmed,
 no IPv6 brackets in socket names)

---
 ext/soap/tests/bugs/GHSA-cj93-vc83-wgqv.phpt | 9 ++++-----
 1 file changed, 4 insertions(+), 5 deletions(-)

diff --git a/ext/soap/tests/bugs/GHSA-cj93-vc83-wgqv.phpt b/ext/soap/tests/bugs/GHSA-cj93-vc83-wgqv.phpt
index 9ba2f04..145f871 100644
--- a/ext/soap/tests/bugs/GHSA-cj93-vc83-wgqv.phpt
+++ b/ext/soap/tests/bugs/GHSA-cj93-vc83-wgqv.phpt
@@ -58,7 +58,7 @@ $wsdl = file_get_contents(__DIR__.'/../server030.wsdl');
 $headers =
     "HTTP/1.1 200 OK\r\n".
     "Content-Type: text/xml;charset=utf-8\r\n".
-    "Transfer-Encoding: \t  chunked\t \r\n".
+    "Transfer-Encoding: chunked\r\n".
     "Connection: close\r\n".
     "\r\n";
 
@@ -69,7 +69,7 @@ $headers =
  * lower and the test no longer thrashes on slower machines. */
 function heavy_soap_server($wsdl, $headers)
 {
-    $server = stream_socket_server('tcp://localhost:0', $errno, $errstr);
+    $server = stream_socket_server('tcp://127.0.0.1:0', $errno, $errstr);
     if (!$server) {
         return false;
     }
@@ -153,6 +153,5 @@ http_server_kill($pid);
