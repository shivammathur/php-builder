From: =?utf-8?b?T25kxZllaiBTdXLDvQ==?= <ondrej@sury.org>
Date: Tue, 10 Nov 2026 15:22:15 +0100
Subject: Adjust the setlocale tests to glibc 2.41

glibc 2.39 and newer describe the en_US digit grouping with a single
element. Backport of upstream commit b6b9eab68e2 (PHP 8.2.20).
---
 .../tests/strings/setlocale_variation3.phpt        | 26 ++++++++--------------
 .../tests/strings/setlocale_variation4.phpt        | 26 ++++++++--------------
 .../tests/strings/setlocale_variation5.phpt        | 26 ++++++++--------------
 3 files changed, 27 insertions(+), 51 deletions(-)

diff --git a/ext/standard/tests/strings/setlocale_variation3.phpt b/ext/standard/tests/strings/setlocale_variation3.phpt
index 2875795..d2dca6d 100644
--- a/ext/standard/tests/strings/setlocale_variation3.phpt
+++ b/ext/standard/tests/strings/setlocale_variation3.phpt
@@ -46,7 +46,7 @@ if($locale_info_before ==  $locale_info_after){
 
 echo "\nDone\n";
 ?>
---EXPECT--
+--EXPECTF--
 *** Testing setlocale() : usage variations - setting system locale = 0 ***
 Locale info, before setting the locale
 array(18) {
@@ -83,17 +83,13 @@ array(18) {
   ["n_sign_posn"]=>
   int(1)
   ["grouping"]=>
-  array(2) {
-    [0]=>
-    int(3)
-    [1]=>
+  array(%d) {%A
+    [%d]=>
     int(3)
   }
   ["mon_grouping"]=>
-  array(2) {
-    [0]=>
-    int(3)
