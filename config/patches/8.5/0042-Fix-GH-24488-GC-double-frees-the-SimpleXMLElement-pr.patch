From: evanford <evankerrickford@gmail.com>
Date: Wed, 21 Oct 2026 14:15:22 -0400
Subject: Fix GH-24488: GC double-frees the SimpleXMLElement properties table

Since the GH-24050 fix, gc_collect_white() adds the table returned by
get_gc to the garbage buffer. sxe_object_free_storage() released
sxe->properties with zend_hash_release(), which does not remove the
table from the GC buffer, so the GC later read and freed it again.
Use zend_array_release(), which goes through zend_array_destroy().

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>

Close GH-24494
---
 ext/simplexml/simplexml.c        |  2 +-
 ext/simplexml/tests/gh24488.phpt | 24 ++++++++++++++++++++++++
 2 files changed, 25 insertions(+), 1 deletion(-)
 create mode 100644 ext/simplexml/tests/gh24488.phpt

diff --git a/ext/simplexml/simplexml.c b/ext/simplexml/simplexml.c
index 9610b3a..367fe37 100644
--- a/ext/simplexml/simplexml.c
+++ b/ext/simplexml/simplexml.c
@@ -2206,7 +2206,7 @@ static void sxe_object_free_storage(zend_object *object)
 
 	if (sxe->properties) {
 		ZEND_ASSERT(!(GC_FLAGS(sxe->properties) & IS_ARRAY_IMMUTABLE));
-		zend_hash_release(sxe->properties);
+		zend_array_release(sxe->properties);
 	}
 }
 /* }}} */
diff --git a/ext/simplexml/tests/gh24488.phpt b/ext/simplexml/tests/gh24488.phpt
new file mode 100644
index 0000000..c8eaf25
--- /dev/null
+++ b/ext/simplexml/tests/gh24488.phpt
@@ -0,0 +1,24 @@
+--TEST--
+GH-24488 (GC double-frees the SimpleXMLElement properties table)
+--EXTENSIONS--
+simplexml
+--FILE--
+<?php
+
+for ($i = 0; $i < 2; $i++) {
+    $xml = new SimpleXMLElement('<a><b/></a>');
+    get_object_vars($xml);
+
+    $holder = new stdClass;
+    $holder->xml = $xml;
+    $holder->self = $holder;
+    unset($xml, $holder);
+
+    gc_collect_cycles();
+    $junk[] = str_repeat('x', 100);
+}
+
+echo "Done\n";
+?>
+--EXPECT--
+Done
