export ASAN_OPTIONS="${ASAN_OPTIONS:-detect_leaks=0}"
export UBSAN_OPTIONS="${UBSAN_OPTIONS:-halt_on_error=1}"
export ZEND_DONT_UNLOAD_MODULES="${ZEND_DONT_UNLOAD_MODULES:-1}"
export USE_ZEND_ALLOC="${USE_ZEND_ALLOC-0}"
# Only mod_php needs LD_PRELOAD in Apache; php-cgi is already linked against libasan.
if [ -e "/etc/apache2/mods-enabled/phpPHP_VERSION.load" ]; then
  export LD_PRELOAD="ASAN_LIB${LD_PRELOAD:+:$LD_PRELOAD}"
fi
